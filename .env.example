# Copy to .env and adjust before `docker compose up`:
#   cp .env.example .env

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobs

# ---------------------------------------------------------------- Prefect
# Prefect uses the same Postgres server but its own database + role
# (created by db/init/00_databases.sql). PREFECT_DB_PASSWORD must match the
# password in that file.
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=prefect
PREFECT_DB_NAME=prefect

# ---------------------------------------------------------------- MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------- Elasticsearch
# Security is disabled for local dev (xpack.security.enabled=false).
# ELASTIC_PASSWORD=changeme

# ---------------------------------------------------------------- Dragonfly (Redis drop-in)
# No auth in dev. Dragonfly provides BOTH the cache (rate-limit / crawl
# frontier) and the message queue (Redis Streams XADD/XREADGROUP).
# The scraper connects via DRAGONFLY_URL=redis://dragonfly:6379/0 (set in
# docker-compose.yml).

# ---------------------------------------------------------------- Scraper
# Use a descriptive User-Agent with contact info (polite crawling).
# The scraper writes to DRAGONFLY_URL (Dragonfly Redis Streams), not Kafka.
SCRAPER_USER_AGENT=JobSearchBot/1.0 (+contact: you@example.com)

# ---------------------------------------------------------------- API
EMBEDDING_DIM=1536

# ---------------------------------------------------------------- Scheduling
# Prefect scheduler (flows/scheduler.py) cron/interval settings
SCRAPE_CRON=0 7 * * *
SEED_CRON=30 6 * * *
CONSUME_INTERVAL_SECONDS=1800
SCHEDULE_TIMEZONE=America/New_York
